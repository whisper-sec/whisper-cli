# Built binaries
/whisper
/whisper.exe
whisper-*-*           # release-named cross-compiled binaries (whisper-linux-amd64, …)
*.exe

# Release/build output
/dist/
/build/

# Checksums + signatures produced by build-all.sh / the release workflow.
# Scoped to the build output on purpose: a bare *.asc also ignores a detached signature
# committed deliberately, and a signature that is silently never added is worse than none,
# because the thing it was supposed to prove is still being claimed.
dist/*.sha256
dist/*.asc
*.sha256
checksums.txt

# Go test/coverage artifacts
*.test
*.out
coverage.txt

# Local environment files - never committed to a public repository
.env
*.env

# Editor / OS cruft
.idea/
.vscode/
*.swp
.DS_Store
