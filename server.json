{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.whisper-sec/whisper",
  "description": "One routable IPv6 per AI agent, verifiable from the DNS root. Keyless tools need no signup.",
  "title": "Whisper",
  "version": "0.219.4",
  "repository": {
    "url": "https://github.com/whisper-sec/whisper-cli",
    "source": "github"
  },
  "websiteUrl": "https://whisper.online",
  "icons": [
    {
      "src": "https://whisper.online/logo.png",
      "mimeType": "image/png"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://whisper.online/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@whisper-security/whisper-mcp",
      "version": "0.219.3",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/whisper-sec/whisper:0.219.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
