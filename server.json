{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.whisper-sec/whisper",
  "description": "One real IPv6 per AI agent: verify any agent keyless; with a key, register, govern and route.",
  "title": "Whisper",
  "version": "0.219.2",
  "repository": {
    "url": "https://github.com/whisper-sec/whisper-cli",
    "source": "github"
  },
  "websiteUrl": "https://whisper.online",
  "icons": [
    {
      "src": "https://whisper.online/logo.png",
      "mimeType": "image/png"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@whisper-security/whisper-mcp",
      "version": "0.219.2",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/whisper-sec/whisper:0.219.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
